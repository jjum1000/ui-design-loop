{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "tokens",
 "type": "object",
 "properties": {
  "category": {
   "enum": [
    "color",
    "type",
    "spacing",
    "nineslice",
    "size"
   ]
  },
  "updatedAt": {
   "type": "string"
  },
  "tokens": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z]+-[0-9a-f]{4,40}$"
     },
     "value": {},
     "valueKey": {
      "type": "string"
     },
     "family": {
      "enum": [
       "base",
       "grade",
       "attribute"
      ]
     },
     "members": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "minItems": 1
     },
     "count": {
      "type": "integer"
     },
     "status": {
      "enum": [
       "미검토",
       "후보"
      ]
     },
     "samples": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    },
    "required": [
     "id",
     "value",
     "valueKey",
     "family",
     "members",
     "count",
     "status"
    ]
   }
  },
  "mapping": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "exceptions": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "value": {
      "type": "string"
     },
     "reason": {
      "type": "string"
     },
     "count": {
      "type": "integer"
     }
    },
    "required": [
     "value",
     "reason"
    ]
   }
  }
 },
 "required": [
  "category",
  "updatedAt",
  "tokens",
  "mapping",
  "exceptions"
 ]
}
